rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definition
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    // User Profile
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'updatedAt']) 
          && data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid
          && data.updatedAt is number
          && (data.keys().hasAll(['email']) ? (data.email is string && data.email.size() <= 256) : true)
          && (data.keys().hasAll(['isDarkMode']) ? (data.isDarkMode is bool) : true)
          && (data.keys().hasAll(['userName']) ? (data.userName is string && data.userName.size() <= 256) : true);
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid; // shouldn't list users
      allow create: if isSignedIn() && isValidId(userId) && userId == request.auth.uid 
                    && incoming().keys().size() >= 2 && incoming().keys().size() <= 5
                    && isValidUser(incoming())
                    && incoming().updatedAt == request.time.toMillis();
      allow update: if isSignedIn() && isValidId(userId) && userId == request.auth.uid
                    && isValidUser(incoming())
                    && incoming().uid == existing().uid
                    && incoming().updatedAt == request.time.toMillis()
                    && incoming().diff(existing()).affectedKeys().hasOnly(['updatedAt', 'email', 'isDarkMode', 'userName']);
      allow delete: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;

      // User Files
      function isValidFileMeta(data) {
        return data.keys().hasAll(['id', 'uid', 'name', 'size', 'type', 'date', 'updatedAt'])
            && data.id is string && data.id.size() <= 256
            && data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid
            && data.name is string && data.name.size() <= 1024
            && data.size is number
            && data.type is string && data.type.size() <= 128
            && data.date is number // Local timestamp, maybe not request.time but generated locally
            && data.updatedAt is number
            && (data.keys().hasAll(['fileData']) ? (data.fileData is string && data.fileData.size() <= 900000) : true);
      }

      match /files/{fileId} {
        allow get: if isSignedIn() && isValidId(fileId) && isValidId(userId) && userId == request.auth.uid;
        allow list: if isSignedIn() && isValidId(userId) && userId == request.auth.uid && resource.data.uid == request.auth.uid;
        allow create: if isSignedIn() && isValidId(userId) && isValidId(fileId) && userId == request.auth.uid
                      && (incoming().keys().size() == 7 || incoming().keys().size() == 8)
                      && isValidFileMeta(incoming())
                      && incoming().updatedAt == request.time.toMillis()
                      && incoming().id == fileId;
        allow update: if isSignedIn() && isValidId(userId) && isValidId(fileId) && userId == request.auth.uid
                      && isValidFileMeta(incoming())
                      && incoming().uid == existing().uid
                      && incoming().id == existing().id
                      && incoming().date == existing().date
                      && incoming().updatedAt == request.time.toMillis()
                      && incoming().diff(existing()).affectedKeys().hasOnly(['updatedAt', 'name', 'size', 'type', 'fileData']);
        allow delete: if isSignedIn() && isValidId(userId) && isValidId(fileId) && userId == request.auth.uid;
      }
    }
  }
}
